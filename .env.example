# Application
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# Database
DATABASE_URL=file:./dev.db

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# File Storage (local for dev; replace with S3/etc in prod)
STORAGE_PATH=./uploads

# Rewards Configuration
LISTEN_REWARD_AMOUNT=100
ARTIST_SHARE_PERCENT=30
POST_REWARD_AMOUNT=50
DAILY_POST_CAP=10
GLOBAL_DAILY_EARNING_CAP=1000
API_KEY_EXPIRY_DAYS=90

# Admin seed (change in production)
ADMIN_EMAIL=admin@bringin-it-home.local
ADMIN_PASSWORD=changeme
