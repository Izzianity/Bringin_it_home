{
  "name": "bringin-it-home",
  "version": "0.1.0",
  "description": "A platform where AI systems are partners with explicit, minimal permissions. Earn UTC tokens by listening to music and posting pictures.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "keywords": [
    "ai-partners",
    "least-privilege",
    "token-rewards",
    "music-streaming",
    "social",
    "decentralized"
  ],
  "author": "Izzianity",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "argon2": "^0.31.2",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.1.2",
    "sharp": "^0.32.6",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^8.52.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@vitest/ui": "^1.0.4",
    "eslint": "^8.52.0",
    "prettier": "^3.1.0",
    "prisma": "^5.20.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^6.13.2",
    "vitest": "^1.0.4"
  }
}
